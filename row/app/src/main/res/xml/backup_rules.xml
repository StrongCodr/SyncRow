<full-backup-content>
    <!-- Do not restore local device data on reinstall. -->
    <exclude domain="file" path="sensors/" />
    <exclude domain="file" path="intervals/" />
    <exclude domain="sharedpref" path="syncrow_prefs.xml" />
</full-backup-content>
